{
    "site_id": "demo-opus",
    "site_name": "OPUS demo-opus",
    "role": "generated-opus-application",
    "kind": "fullstack",
    "status": "generated",
    "blueprint": "opus-fullstack",
    "generated_by": "composer",
    "contract": "OPUS_SITE_LAYERED_CONTRACT_V2",
    "application_profile": {
        "contract": "OPUS_APPLICATION_PROFILE_V2",
        "type": "fullstack",
        "capabilities": {
            "presentation": true,
            "api": true,
            "persistence": true
        },
        "composition": [
            "front",
            "back"
        ]
    },
    "default_locale": "fr",
    "locales": [
        "bg",
        "hr",
        "cs",
        "da",
        "nl",
        "en",
        "et",
        "fi",
        "fr",
        "de",
        "el",
        "hu",
        "ga",
        "it",
        "lv",
        "lt",
        "mt",
        "pl",
        "pt",
        "ro",
        "sk",
        "sl",
        "es",
        "sv",
        "uk"
    ],
    "locale_negotiation": {
        "contract": "OPUS_BROWSER_LOCALE_NEGOTIATION_V1",
        "strategy": "accept-language",
        "explicit_route_locale": true,
        "fallback_locale": "fr",
        "fallback_diagnostic": true
    },
    "diagnostics": {
        "contract": "OPUS_APPLICATION_DIAGNOSTICS_V1",
        "logger": {
            "required": true,
            "file": "var/logs/application.log"
        },
        "profiler": {
            "required": true,
            "storage": "var/profiler",
            "trace_id": "generated"
        }
    },
    "theme": "starter",
    "application_root": "application",
    "default_root": "application/front/default",
    "application_fsm": "config/application.fsm.json",
    "dispatch_model": "fsm-module-first",
    "public_root": "www",
    "asset_root": "www/asset",
    "navigation": {
        "fsm": "config/application.fsm.json"
    },
    "runtime": {
        "contract": "OPUS_APPLICATION_SINGLETON_V1",
        "architecture": "singleton",
        "class": "DemoOpusApplication",
        "file": "application/shared/runtime/Application.php",
        "bootstrap": "application/shared/runtime/bootstrap.php",
        "entrypoint": "www/index.php",
        "factory": "instance",
        "runner": "run",
        "mode_environment": "OPUS_APPLICATION_RUNTIME_MODE"
    },
    "application_layers": {
        "contract": "OPUS_APPLICATION_LAYER_LAYOUT_V1",
        "shared": "application/shared",
        "front": "application/front",
        "back": "application/back"
    },
    "runtime_modes": [
        "front",
        "back"
    ],
    "deployment": {
        "contract": "OPUS_REVERSE_PROXY_DEPLOYMENT_V1",
        "public_https_port": 443,
        "front_internal_port_default": 8000,
        "back_internal_port_default": 8792,
        "ports_configurable": true,
        "back_publicly_exposed": false,
        "reverse_proxy_required": true
    }
}
