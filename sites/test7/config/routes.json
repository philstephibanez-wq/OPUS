{
    "contract": "OPUS_ROUTE_REGISTRY_V1",
    "dispatch_model": "fsm-module-first",
    "routes": [
        {
            "id": "home.index",
            "path": "/",
            "state": "home",
            "module": "home",
            "action": "index",
            "template": "home/templates/index.score",
            "view": "home/views/index.php",
            "label": "menu.home",
            "title_key": "page.title",
            "subtitle_key": "page.subtitle",
            "acl": "home",
            "fsm_state": "home",
            "dispatch_action": "render_route",
            "show_in_menu": true,
            "order": 10
        },
        {
            "id": "profiler.trace",
            "path": "/_opus/profiler/trace/{trace_id}",
            "state": "profiler",
            "module": "profiler",
            "action": "view",
            "acl": "profiler:view",
            "fsm_state": "profiler",
            "dispatch_action": "render_profiler_trace",
            "show_in_menu": false,
            "order": 900
        }
    ]
}

