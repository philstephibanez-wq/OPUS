{
    "contract": "OPUS_REST_API_COMPOSER_OPERATION_CATALOG_V1",
    "operations": {
        "site.validate": {
            "composer_script": "opus:validate-site",
            "roles": [
                "admin"
            ],
            "arguments": [
                {
                    "name": "site_id",
                    "required": true,
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "max_length": 64
                }
            ]
        }
    }
}

