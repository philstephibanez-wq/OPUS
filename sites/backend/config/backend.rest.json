{
    "contract": "OPUS_REST_API_SERVER_CONFIG_V1",
    "application_id": "backend",
    "base_path": "/api/v1",
    "operation_catalog": "sites/backend/config/backend.operations.json",
    "composer_command": [
        "@in-process"
    ],
    "timeout_seconds": 120,
    "max_output_bytes": 2097152,
    "resources": [
        {
            "method": "GET",
            "path": "/api/v1/application/validation",
            "operation": "site.validate",
            "parameters": {
                "site_id": "backend"
            },
            "success_status": 200
        }
    ],
    "supported_locales": [
        "bg",
        "hr",
        "cs",
        "da",
        "nl",
        "en",
        "et",
        "fi",
        "fr",
        "de",
        "el",
        "hu",
        "ga",
        "it",
        "lv",
        "lt",
        "mt",
        "pl",
        "pt",
        "ro",
        "sk",
        "sl",
        "es",
        "sv",
        "uk"
    ],
    "default_locale": "fr",
    "authentication": {
        "mode": "environment_hmac",
        "service": "backend-front",
        "token_env": "OPUS_BACKEND_BACKEND_TOKEN",
        "hmac_env": "OPUS_BACKEND_BACKEND_HMAC",
        "minimum_secret_length": 32,
        "max_clock_skew_seconds": 60,
        "delegated_roles": [
            "admin"
        ],
        "delegated_providers": [
            "session",
            "local-password",
            "auth0-proxy"
        ],
        "trusted_proxy_addresses": [
            "127.0.0.1",
            "::1"
        ],
        "proxy_secret_env": "OPUS_BACKEND_AUTH0_PROXY_SECRET"
    },
    "fsm": {
        "initial_state": "received",
        "transitions": {
            "received": [
                "authenticated",
                "failed"
            ],
            "authenticated": [
                "authorized",
                "failed"
            ],
            "authorized": [
                "dispatching",
                "failed"
            ],
            "dispatching": [
                "succeeded",
                "failed"
            ],
            "succeeded": [],
            "failed": []
        }
    },
    "diagnostics": {
        "log_directory": "sites/backend/var/logs",
        "log_file": "backend.log",
        "profiler_directory": "sites/backend/var/profiler/rest"
    }
}

