{
    "contract": "OPUS_APPLICATION_FSM_V1",
    "name": "backend.application",
    "site_id": "backend",
    "initial_state": "begin",
    "states": [
        {
            "id": "begin",
            "type": "entry",
            "module": "api",
            "route": "/api/v1/{*resource}"
        },
        {
            "id": "api",
            "module": "api",
            "route": "/api/v1/{*resource}"
        }
    ],
    "transitions": [
        {
            "id": "dispatch.api.from.begin",
            "from": "begin",
            "signal": "dispatch_api",
            "next_state": "api",
            "guards": [
                "route_exists"
            ],
            "actions": [
                "dispatch_rest"
            ]
        },
        {
            "id": "dispatch.api",
            "from": "api",
            "signal": "dispatch_api",
            "next_state": "api",
            "guards": [
                "route_exists"
            ],
            "actions": [
                "dispatch_rest"
            ]
        }
    ]
}
