{
  "contract": "OPUS_SITE_STANDARD_CONTRACT_CORE",
  "site_id": "owasys-back",
  "role": "standard-opus-application",
  "kind": "backend",
  "application_root": "application",
  "default_root": "application/default",
  "public_root": "www",
  "dispatch_model": "fsm-module-first",
  "default_locale": "fr-FR",
  "locales": [
    "bg-BG",
    "hr-HR",
    "cs-CZ",
    "da-DK",
    "nl-NL",
    "nl-BE",
    "en-IE",
    "en-MT",
    "et-EE",
    "fi-FI",
    "fr-FR",
    "fr-BE",
    "fr-LU",
    "fr-CH",
    "de-DE",
    "de-AT",
    "de-BE",
    "de-LU",
    "de-CH",
    "el-GR",
    "el-CY",
    "hu-HU",
    "ga-IE",
    "it-IT",
    "it-CH",
    "lv-LV",
    "lt-LT",
    "mt-MT",
    "pl-PL",
    "pt-PT",
    "ro-RO",
    "sk-SK",
    "sl-SI",
    "es-ES",
    "sv-SE",
    "sv-FI",
    "uk-UA"
  ],
  "application_surface": {
    "contract": "OPUS_APPLICATION_SURFACE_V1",
    "type": "backend"
  },
  "navigation": {
    "fsm": "config/fsm.json"
  },
  "runtime": {
    "contract": "OPUS_APPLICATION_SINGLETON_V1",
    "architecture": "singleton",
    "class": "OwasysBackApplication",
    "file": "application/default/Application.php",
    "bootstrap": "application/default/bootstrap.php",
    "entrypoint": "www/index.php",
    "factory": "instance",
    "runner": "run"
  },
  "development_server": {
    "contract": "OPUS_DEVELOPMENT_SERVER_V1",
    "enabled": true,
    "diagnostics": {
      "log": "var/logs/owasys-back.log",
      "profiler": "var/profiler/dev-server"
    },
    "environment": {
      "contract": "OPUS_DEVELOPMENT_ENVIRONMENT_BINDING_V1",
      "file": "var/development/environment.json",
      "required": [
        "OPUS_OWASYS_BACKEND_TOKEN",
        "OPUS_OWASYS_BACKEND_HMAC"
      ]
    }
  },
  "auth": {
    "minimum_password_length": 10
  },
  "exchange": {
    "contract": "OWASYS_REST_EXCHANGE_V1",
    "transport": "rest",
    "peer_application_id": "owasys-front",
    "configuration": "config/backend.rest.json",
    "cross_application_filesystem_access": false
  }
}
