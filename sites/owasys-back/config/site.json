{
  "contract": "OPUS_SITE_STANDARD_CONTRACT_CORE",
  "site_id": "owasys-back",
  "role": "standard-opus-application",
  "kind": "backend",
  "application_root": "application",
  "default_root": "application/default",
  "public_root": "www",
  "dispatch_model": "fsm-module-first",
  "default_locale": "fr-FR",
  "locales": [
    "bg-BG",
    "hr-HR",
    "cs-CZ",
    "da-DK",
    "nl-NL",
    "nl-BE",
    "en-IE",
    "en-MT",
    "et-EE",
    "fi-FI",
    "fr-FR",
    "fr-BE",
    "fr-LU",
    "fr-CH",
    "de-DE",
    "de-AT",
    "de-BE",
    "de-LU",
    "de-CH",
    "el-GR",
    "el-CY",
    "hu-HU",
    "ga-IE",
    "it-IT",
    "it-CH",
    "lv-LV",
    "lt-LT",
    "mt-MT",
    "pl-PL",
    "pt-PT",
    "ro-RO",
    "sk-SK",
    "sl-SI",
    "es-ES",
    "sv-SE",
    "sv-FI",
    "uk-UA"
  ],
  "i18n": {
    "contract": "OPUS_APPLICATION_I18N_POLICY_V4",
    "default_source": "browser",
    "fallback_locale": "fr-FR",
    "catalog_format": "json",
    "supported_catalog_formats": [
      "json",
      "yaml",
      "yml",
      "xml"
    ],
    "locale_tag_style": "bcp47",
    "allow_regional_variants": true,
    "catalogs_versioned": true,
    "regional_overlay_policy": "explicit-empty-overlay-inherits-base-language",
    "silent_fallback": false,
    "selectable_locales": "regional-only",
    "bare_language_policy": "map-to-default-regional-locale",
    "language_defaults": {
      "bg": "bg-BG",
      "hr": "hr-HR",
      "cs": "cs-CZ",
      "da": "da-DK",
      "nl": "nl-NL",
      "en": "en-IE",
      "et": "et-EE",
      "fi": "fi-FI",
      "fr": "fr-FR",
      "de": "de-DE",
      "el": "el-GR",
      "hu": "hu-HU",
      "ga": "ga-IE",
      "it": "it-IT",
      "lv": "lv-LV",
      "lt": "lt-LT",
      "mt": "mt-MT",
      "pl": "pl-PL",
      "pt": "pt-PT",
      "ro": "ro-RO",
      "sk": "sk-SK",
      "sl": "sl-SI",
      "es": "es-ES",
      "sv": "sv-SE",
      "uk": "uk-UA"
    },
    "catalog_base_locales": [
      "bg",
      "hr",
      "cs",
      "da",
      "nl",
      "en",
      "et",
      "fi",
      "fr",
      "de",
      "el",
      "hu",
      "ga",
      "it",
      "lv",
      "lt",
      "mt",
      "pl",
      "pt",
      "ro",
      "sk",
      "sl",
      "es",
      "sv",
      "uk"
    ],
    "catalog_base_locales_visible": false
  },
  "application_surface": {
    "contract": "OPUS_APPLICATION_SURFACE_V1",
    "type": "backend"
  },
  "navigation": {
    "fsm": "config/fsm.json"
  },
  "runtime": {
    "contract": "OPUS_APPLICATION_SINGLETON_V1",
    "architecture": "singleton",
    "class": "OwasysBackApplication",
    "file": "application/default/Application.php",
    "bootstrap": "application/default/bootstrap.php",
    "entrypoint": "www/index.php",
    "factory": "instance",
    "runner": "run"
  },
  "development_server": {
    "contract": "OPUS_DEVELOPMENT_SERVER_V1",
    "enabled": true,
    "diagnostics": {
      "log": "var/logs/owasys-back.log",
      "profiler": "var/profiler/dev-server"
    },
    "environment": {
      "contract": "OPUS_DEVELOPMENT_ENVIRONMENT_BINDING_V1",
      "file": "var/development/environment.json",
      "required": [
        "OPUS_OWASYS_FRONTEND_HOST",
        "OPUS_OWASYS_FRONTEND_PORT",
        "OPUS_OWASYS_FRONTEND_ENDPOINT",
        "OPUS_OWASYS_BACKEND_TOKEN",
        "OPUS_OWASYS_BACKEND_HMAC"
      ]
    },
    "network": {
      "contract": "OPUS_DEVELOPMENT_NETWORK_BINDING_V1",
      "local": {
        "host_env": "OPUS_DEV_SERVER_HOST",
        "port_env": "OPUS_DEV_SERVER_PORT",
        "url_env": "OPUS_DEV_SERVER_URL"
      },
      "peer": {
        "application_id": "owasys-front",
        "host_env": "OPUS_OWASYS_FRONTEND_HOST",
        "port_env": "OPUS_OWASYS_FRONTEND_PORT",
        "url_env": "OPUS_OWASYS_FRONTEND_ENDPOINT"
      }
    }
  },
  "auth": {
    "minimum_password_length": 10
  },
  "exchange": {
    "contract": "OWASYS_REST_EXCHANGE_V1",
    "transport": "rest",
    "peer_application_id": "owasys-front",
    "configuration": "config/backend.rest.json",
    "cross_application_filesystem_access": false
  }
}
