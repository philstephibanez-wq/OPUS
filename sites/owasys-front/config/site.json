{
  "contract": "OPUS_SITE_STANDARD_CONTRACT_CORE",
  "site_id": "owasys-front",
  "role": "standard-opus-application",
  "kind": "frontend",
  "application_root": "application",
  "default_root": "application/default",
  "public_root": "www",
  "dispatch_model": "fsm-module-first",
  "default_locale": "fr-FR",
  "locales": [
    "bg-BG",
    "hr-HR",
    "cs-CZ",
    "da-DK",
    "nl-NL",
    "nl-BE",
    "en-IE",
    "en-MT",
    "et-EE",
    "fi-FI",
    "fr-FR",
    "fr-BE",
    "fr-LU",
    "fr-CH",
    "de-DE",
    "de-AT",
    "de-BE",
    "de-LU",
    "de-CH",
    "el-GR",
    "el-CY",
    "hu-HU",
    "ga-IE",
    "it-IT",
    "it-CH",
    "lv-LV",
    "lt-LT",
    "mt-MT",
    "pl-PL",
    "pt-PT",
    "ro-RO",
    "sk-SK",
    "sl-SI",
    "es-ES",
    "sv-SE",
    "sv-FI",
    "uk-UA"
  ],
  "application_surface": {
    "contract": "OPUS_APPLICATION_SURFACE_V1",
    "type": "frontend"
  },
  "navigation": {
    "fsm": "config/fsm.json"
  },
  "runtime": {
    "contract": "OPUS_APPLICATION_SINGLETON_V1",
    "architecture": "singleton",
    "class": "OwasysFrontApplication",
    "file": "application/default/Application.php",
    "bootstrap": "application/default/bootstrap.php",
    "entrypoint": "www/index.php",
    "factory": "instance",
    "runner": "run"
  },
  "development_server": {
    "contract": "OPUS_DEVELOPMENT_SERVER_V1",
    "enabled": true,
    "registry": {
      "contract": "OPUS_DEVELOPMENT_SERVER_REGISTRY_V1",
      "file": "runtime/development/servers.json"
    },
    "peers": {
      "OPUS_OWASYS_BACKEND_ENDPOINT": {
        "application_id": "owasys-back",
        "path": "/api/v1/executions"
      }
    },
    "secrets": {
      "contract": "OPUS_RUNTIME_SECRET_BINDING_V1",
      "scope": "opus-root",
      "store": "runtime/development/owasys-rcp-secrets.json",
      "bindings": {
        "OPUS_OWASYS_BACKEND_TOKEN": "owasys_backend_token",
        "OPUS_OWASYS_BACKEND_HMAC": "owasys_backend_hmac"
      }
    },
    "diagnostics": {
      "log": "var/logs/owasys-front.log",
      "profiler": "var/profiler/dev-server"
    }
  },
  "shared_contract": {
    "source": "sites/owasys-shared/deployment/compatibility.json",
    "version": "1.0.0",
    "api_contract_version": "1.0.0"
  },
  "auth": {
    "minimum_password_length": 10
  }
}
