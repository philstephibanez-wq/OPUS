{
  "contract": "OWASYS_NAVIGATION_FSM_V1",
  "name": "OWASYS navigation FSM",
  "source_of_truth": "config",
  "diagram": {
    "contract": "OWASYS_FSM_MERMAID_V1",
    "direction": "LR",
    "rule": "Only transitions with visual=true are projected. visual_from overrides a wildcard runtime source for diagram display only."
  },
  "initial_state": "login",
  "states": [
    {"id":"login","module":"login","route":"login","requires_auth":false,"requires_current_app":false,"title_key":"auth.sign_in","summary_key":"auth.sign_in_description"},
    {"id":"account","module":"account","route":"account/password","requires_auth":true,"requires_current_app":false,"title_key":"auth.change_password","summary_key":"auth.change_password_description"},
    {"id":"registry","module":"registry","route":"applications","requires_auth":true,"requires_current_app":false,"title_key":"menu.applications","summary_key":"registry.description","navigation":{"visible":true,"order":10,"label":"menu.applications"}},
    {"id":"creation","module":"creation","route":"applications/new","requires_auth":true,"requires_current_app":false,"title_key":"creation.title","summary_key":"creation.description","navigation":{"visible":false,"order":15,"label":"creation.title"}},
    {"id":"structure","module":"structure","route":"structure","requires_auth":true,"requires_current_app":true,"title_key":"menu.structure","summary_key":"state.default.summary","navigation":{"visible":true,"order":20,"label":"menu.structure"}},
    {"id":"data","module":"data","route":"data","requires_auth":true,"requires_current_app":true,"title_key":"menu.data","summary_key":"state.default.summary","navigation":{"visible":true,"order":30,"label":"menu.data"}},
    {"id":"workflows","module":"workflows","route":"workflows","requires_auth":true,"requires_current_app":true,"title_key":"menu.workflows","summary_key":"state.default.summary","navigation":{"visible":true,"order":40,"label":"menu.workflows"}},
    {"id":"security","module":"security","route":"security","requires_auth":true,"requires_current_app":true,"title_key":"menu.security","summary_key":"state.default.summary","navigation":{"visible":true,"order":50,"label":"menu.security"}},
    {"id":"source","module":"source","route":"source","requires_auth":true,"requires_current_app":true,"title_key":"menu.source","summary_key":"state.default.summary","navigation":{"visible":true,"order":60,"label":"menu.source"}},
    {"id":"build","module":"build","route":"build","requires_auth":true,"requires_current_app":true,"title_key":"menu.build","summary_key":"state.default.summary","navigation":{"visible":true,"order":70,"label":"menu.build"}}
  ],
  "signals": [
    {"id":"open_login"},{"id":"open_account"},{"id":"login_success"},{"id":"login_failed"},
    {"id":"password_change_required"},{"id":"password_changed"},{"id":"password_change_failed"},
    {"id":"select_app"},{"id":"change_app"},{"id":"clear_app_context"},{"id":"create_new_app"},{"id":"application_deleted"},
    {"id":"open_creation"},{"id":"application_created"},{"id":"application_creation_failed"},{"id":"cancel_creation"},
    {"id":"registry_action_failed"},{"id":"open_structure"},{"id":"open_data"},{"id":"open_workflows"},
    {"id":"open_security"},{"id":"open_source"},{"id":"preview_source"},{"id":"source_previewed"},
    {"id":"write_source"},{"id":"source_written"},{"id":"source_conflict"},{"id":"source_action_failed"},
    {"id":"stage_source"},{"id":"source_staged"},{"id":"unstage_source"},{"id":"source_unstaged"},
    {"id":"commit_source"},{"id":"source_committed"},{"id":"restore_source"},{"id":"source_restored"},{"id":"git_action_failed"},
    {"id":"open_profiler"},{"id":"close_profiler"},{"id":"open_build"},{"id":"auth_required"},{"id":"logout"}
  ],
  "transitions": [
    {"id":"t_open_login","from":"*","signal":"open_login","next_state":"login"},
    {"id":"t_login_success","from":"login","signal":"login_success","next_state":"registry","actions":["start_session"]},
    {"id":"t_login_failed","from":"login","signal":"login_failed","next_state":"login"},
    {"id":"t_password_required","from":"login","signal":"password_change_required","next_state":"account","guards":["must_change_password"],"actions":["start_session","redirect_password_change"]},
    {"id":"t_open_account","from":"*","signal":"open_account","next_state":"account"},
    {"id":"t_password_changed","from":"account","signal":"password_changed","next_state":"registry","actions":["update_runtime_password_hash","clear_must_change_password"]},
    {"id":"t_password_failed","from":"account","signal":"password_change_failed","next_state":"account"},
    {"id":"t_select_app","from":"registry","signal":"select_app","next_state":"structure","guards":["app_exists"],"actions":["set_current_app"],"visual":true},
    {"id":"t_clear_context","from":"registry","signal":"clear_app_context","next_state":"registry","actions":["clear_current_app"]},
    {"id":"t_create_app","from":"registry","signal":"create_new_app","next_state":"creation","actions":["clear_current_app"],"visual":true},
    {"id":"t_delete_app","from":"registry","signal":"application_deleted","next_state":"registry","actions":["clear_current_app"]},
    {"id":"t_open_creation","from":"*","signal":"open_creation","next_state":"creation"},
    {"id":"t_creation_created","from":"creation","signal":"application_created","next_state":"build","guards":["app_exists"],"actions":["set_current_app"],"visual":true},
    {"id":"t_creation_failed","from":"creation","signal":"application_creation_failed","next_state":"creation"},
    {"id":"t_creation_cancel","from":"creation","signal":"cancel_creation","next_state":"registry"},
    {"id":"t_registry_failed","from":"registry","signal":"registry_action_failed","next_state":"registry"},
    {"id":"t_change_app","from":"*","signal":"change_app","next_state":"registry"},
    {"id":"t_open_structure","from":"*","signal":"open_structure","next_state":"structure","guards":["current_app_required"]},
    {"id":"t_open_data","from":"*","signal":"open_data","next_state":"data","guards":["current_app_required"],"visual":true,"visual_from":"structure"},
    {"id":"t_open_workflows","from":"*","signal":"open_workflows","next_state":"workflows","guards":["current_app_required"],"visual":true,"visual_from":"data"},
    {"id":"t_open_security","from":"*","signal":"open_security","next_state":"security","guards":["current_app_required"],"visual":true,"visual_from":"workflows"},
    {"id":"t_open_source","from":"*","signal":"open_source","next_state":"source","guards":["current_app_required"],"visual":true,"visual_from":"security"},
    {"id":"t_source_file","from":"source","signal":"open_source_file","next_state":"source","guards":["current_app_required"],"runtime_operations":[{"op":"push","context":"source_path"},{"op":"poke","name":"source_path","context":"source_path"},{"op":"poke","name":"locale","context":"locale"}]},
    {"id":"t_source_locale","from":"source","signal":"change_locale","next_state":"source","guards":["current_app_required"],"runtime_operations":[{"op":"poke","name":"locale","context":"locale"}]},
    {"id":"t_source_preview_requested","from":"source","signal":"preview_source","next_state":"source","guards":["current_app_required"]},
    {"id":"t_source_previewed","from":"source","signal":"source_previewed","next_state":"source","guards":["current_app_required"]},
    {"id":"t_source_write_requested","from":"source","signal":"write_source","next_state":"source","guards":["current_app_required"]},
    {"id":"t_source_written","from":"source","signal":"source_written","next_state":"source","guards":["current_app_required"]},
    {"id":"t_source_conflict","from":"source","signal":"source_conflict","next_state":"source","guards":["current_app_required"]},
    {"id":"t_source_action_failed","from":"source","signal":"source_action_failed","next_state":"source","guards":["current_app_required"]},
    {"id":"t_git_stage_requested","from":"source","signal":"stage_source","next_state":"source","guards":["current_app_required"],"runtime_operations":[{"op":"poke","name":"git_action","context":"git_action"},{"op":"poke","name":"git_path","context":"git_path"}]},
    {"id":"t_git_staged","from":"source","signal":"source_staged","next_state":"source","guards":["current_app_required"]},
    {"id":"t_git_unstage_requested","from":"source","signal":"unstage_source","next_state":"source","guards":["current_app_required"],"runtime_operations":[{"op":"poke","name":"git_action","context":"git_action"},{"op":"poke","name":"git_path","context":"git_path"}]},
    {"id":"t_git_unstaged","from":"source","signal":"source_unstaged","next_state":"source","guards":["current_app_required"]},
    {"id":"t_git_commit_requested","from":"source","signal":"commit_source","next_state":"source","guards":["current_app_required"],"runtime_operations":[{"op":"poke","name":"git_action","context":"git_action"}]},
    {"id":"t_git_committed","from":"source","signal":"source_committed","next_state":"source","guards":["current_app_required"]},
    {"id":"t_git_restore_requested","from":"source","signal":"restore_source","next_state":"source","guards":["current_app_required"],"runtime_operations":[{"op":"poke","name":"git_action","context":"git_action"},{"op":"poke","name":"git_path","context":"git_path"}]},
    {"id":"t_git_restored","from":"source","signal":"source_restored","next_state":"source","guards":["current_app_required"]},
    {"id":"t_git_action_failed","from":"source","signal":"git_action_failed","next_state":"source","guards":["current_app_required"]},
    {"id":"t_source_profiler_open","from":"source","signal":"open_profiler","next_state":"source","guards":["current_app_required"],"runtime_operations":[{"op":"push","context":"return_url"},{"op":"poke","name":"profiler_open","context":"profiler_open"},{"op":"poke","name":"profiler_trace_id","context":"trace_id"}]},
    {"id":"t_source_profiler_close","from":"source","signal":"close_profiler","next_state":"source","guards":["current_app_required"],"runtime_operations":[{"op":"pop","name":"profiler_return_url"},{"op":"poke","name":"profiler_open","context":"profiler_open"}]},
    {"id":"t_open_build","from":"*","signal":"open_build","next_state":"build","guards":["current_app_required"],"visual":true,"visual_from":"source"},
    {"id":"t_auth_required","from":"*","signal":"auth_required","next_state":"login","actions":["clear_session"]},
    {"id":"t_logout","from":"*","signal":"logout","next_state":"login","actions":["clear_current_app","clear_session"]}
  ],
  "guards": {
    "app_exists": "The selected or newly created application must be present in the Registry snapshot.",
    "current_app_required": "A current OPUS application must be selected in OWASYS session context.",
    "must_change_password": "The authenticated identity must complete the required password change."
  },
  "actions": {
    "set_current_app": "Persist selection through REST + Composer and store the canonical Registry entry in the OWASYS session.",
    "clear_current_app": "Clear the current application context before selection or creation.",
    "start_session": "Create the authenticated OWASYS runtime session.",
    "clear_session": "Destroy the authenticated OWASYS runtime session.",
    "update_runtime_password_hash": "Update the authenticated account through the secured backend.",
    "clear_must_change_password": "Clear the password-change requirement in session.",
    "redirect_password_change": "Redirect to the account password state."
  }
}
