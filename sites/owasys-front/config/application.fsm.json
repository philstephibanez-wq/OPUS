{
    "contract": "OWASYS_HOST_CONTEXT_FSM_V1",
    "name": "owasys-front.application",
    "site_id": "owasys-front",
    "efsm_id": "application",
    "initial_state": "essai",
    "signals": [
        {
            "id": "enter_application_context",
            "origin": "automatic",
            "type": "command"
        }
    ],
    "states": [
        {
            "id": "essai",
            "label_key": "fsm.application.state.essai.label"
        },
        {
            "id": "selected"
        }
    ],
    "transitions": [
        {
            "id": "transition.modiee",
            "from": "essai",
            "signal": "enter_application_context",
            "next_state": "selected",
            "label_key": "fsm.application.transition.transition.modiee.label"
        },
        {
            "id": "application.context.enter.selected",
            "from": "selected",
            "signal": "enter_application_context",
            "next_state": "selected",
            "label_key": "fsm.application.transition.application.context.enter.selected.label"
        }
    ]
}
