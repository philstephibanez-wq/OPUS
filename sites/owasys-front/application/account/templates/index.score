<section class="ow-panel ow-auth-panel">
  <header>
    <span class="ow-badge">[[ i18n: menu.account ]]</span>
    <h2>[[ i18n: menu.account ]]</h2>
  </header>
  <p><strong>{{ identity.label }}</strong></p>
  <p class="ow-muted">{{ identity.primary_role }}</p>
  [[ if: auth.can_change_password ]]
    <p><a href="{{ urls.password }}">[[ i18n: auth.change_password ]]</a></p>
  [[ endif ]]
</section>
