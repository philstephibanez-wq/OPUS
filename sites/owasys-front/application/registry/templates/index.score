[[ if: registry.error_application_required ]]<p class="ow-error">[[ i18n: registry.error.application_required ]]</p>[[ endif ]]
[[ if: registry.error_application_not_found ]]<p class="ow-error">[[ i18n: registry.error.application_not_found ]]</p>[[ endif ]]
[[ if: registry.error_action_invalid ]]<p class="ow-error">[[ i18n: registry.error.action_invalid ]]</p>[[ endif ]]
[[ if: registry.error_application_protected ]]<p class="ow-error">[[ i18n: registry.error.action_invalid ]]</p>[[ endif ]]
[[ if: registry.error_delete_confirmation ]]<p class="ow-error">[[ i18n: registry.error.action_invalid ]]</p>[[ endif ]]
[[ if: registry.error_delete_failed ]]<p class="ow-error">[[ i18n: registry.error.action_invalid ]]</p>[[ endif ]]
<section class="ow-card ow-app-tree ow-registry-topology">
  <div class="ow-section-heading">
    <div>
      <h2>[[ i18n: menu.applications ]]</h2>
      <p class="ow-muted">[[ i18n: registry.select_instruction ]]</p>
    </div>
    <div class="ow-tags"><span>[[ i18n: registry.sync_total ]]: {{ sync.total }}</span></div>
  </div>
  <div class="ow-inline-form">
    [[ if: registry.can_create ]]
      <form method="post" action="{{ urls.current }}"><input type="hidden" name="owasys_action" value="create-new-app"><button class="ow-button" type="submit">[[ i18n: registry.create_application ]]</button></form>
    [[ endif ]]
    [[ if: current_app.present ]]
      [[ if: registry.can_clear ]]
        <form method="post" action="{{ urls.current }}"><input type="hidden" name="owasys_action" value="clear-app-context"><button class="ow-button ow-button-secondary" type="submit">[[ i18n: registry.clear_current_context ]]</button></form>
      [[ endif ]]
    [[ endif ]]
  </div>
  [[ if: registry.empty ]]
    <div class="ow-tree-empty"><h3>[[ i18n: registry.empty_title ]]</h3><p class="ow-muted">[[ i18n: registry.empty_description ]]</p></div>
  [[ else ]]
    <div class="ow-tree-root ow-topology-root"><span class="ow-badge">[[ i18n: brand.name ]]</span><strong>[[ i18n: brand.name ]]</strong></div>
    <div class="ow-tree-branches ow-core-row">
      [[ foreach: entries as entry ]]
        [[ if: entry.deletable ]]
        [[ else ]]
          <article class="ow-tree-app[[ if: entry.current ]] is-current[[ endif ]]">
            <form method="post" action="{{ urls.current }}">
              <input type="hidden" name="owasys_action" value="select-app"><input type="hidden" name="owasys_app_id" value="{{ entry.id }}">
              <button type="submit" [[ if: entry.current ]]disabled aria-current="true"[[ endif ]] [[ if: registry.cannot_select ]]disabled[[ endif ]]>
                <span class="ow-app-card-heading"><strong>{{ entry.name }}</strong></span>
                <em>[[ if: entry.current ]][[ i18n: registry.current_application ]][[ else ]][[ i18n: registry.work_on_this_app ]][[ endif ]]</em>
              </button>
            </form>
          </article>
        [[ endif ]]
      [[ endforeach ]]
    </div>
    <section class="ow-generated-group">
      <div class="ow-section-heading ow-generated-heading"><div><h3>[[ i18n: menu.applications ]]</h3><p class="ow-muted">[[ i18n: registry.select_instruction ]]</p></div></div>
      <div class="ow-tree-branches ow-generated-row">
        [[ foreach: entries as entry ]]
          [[ if: entry.deletable ]]
            <article class="ow-tree-app[[ if: entry.current ]] is-current[[ endif ]]">
              <form method="post" action="{{ urls.current }}">
                <input type="hidden" name="owasys_action" value="select-app"><input type="hidden" name="owasys_app_id" value="{{ entry.id }}">
                <button type="submit" [[ if: entry.current ]]disabled aria-current="true"[[ endif ]] [[ if: registry.cannot_select ]]disabled[[ endif ]]>
                  <span class="ow-app-card-heading"><strong>{{ entry.name }}</strong></span>
                  <em>[[ if: entry.current ]][[ i18n: registry.current_application ]][[ else ]][[ i18n: registry.work_on_this_app ]][[ endif ]]</em>
                </button>
              </form>
              [[ if: registry.can_delete ]]
                <form method="post" action="{{ urls.current }}" class="ow-delete-form">
                  <input type="hidden" name="owasys_action" value="delete-app"><input type="hidden" name="owasys_app_id" value="{{ entry.id }}">
                  <label><span>[[ i18n: common.id ]]</span><input type="text" name="owasys_delete_confirmation" required autocomplete="off" aria-label="[[ i18n: common.id ]]"></label>
                  <button class="ow-button ow-button-danger" type="submit">[[ i18n: fsm_designer.delete ]]</button>
                </form>
              [[ endif ]]
            </article>
          [[ endif ]]
        [[ endforeach ]]
      </div>
    </section>
  [[ endif ]]
</section>
