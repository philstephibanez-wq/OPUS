<link rel="stylesheet" href="{{ assets.creation_css }}">

[[ if: creation.has_error ]]
  <section class="ow-card ow-error" role="alert">
    <h2>[[ i18n: creation.error.title ]]</h2>
    [[ if: creation.error_site_id ]]<p>[[ i18n: creation.error.site_id ]]</p>[[ endif ]]
    [[ if: creation.error_profile ]]<p>[[ i18n: creation.error.profile ]]</p>[[ endif ]]
    [[ if: creation.error_exists ]]<p>[[ i18n: creation.error.exists ]]</p>[[ endif ]]
    [[ if: creation.error_backend ]]<p>[[ i18n: creation.error.backend ]]</p>[[ endif ]]
    [[ if: creation.error_action ]]<p>[[ i18n: creation.error.action ]]</p>[[ endif ]]
    [[ if: creation.error_method ]]<p>[[ i18n: creation.error.method ]]</p>[[ endif ]]
    [[ if: creation.trace_id ]]<p><span>[[ i18n: creation.error.trace ]]</span> <code>{{ creation.trace_id }}</code></p>[[ endif ]]
    [[ if: creation.error_code ]]<code>{{ creation.error_code }}</code>[[ endif ]]
  </section>
[[ endif ]]

<section class="ow-card ow-creation-wizard">
  <div class="ow-section-heading">
    <div>
      <h2>[[ i18n: creation.choose_profile ]]</h2>
      <p class="ow-muted">[[ i18n: creation.choose_profile_description ]]</p>
    </div>
  </div>

  <form method="post" action="{{ urls.current }}" class="ow-creation-form">
    <div class="ow-form-field">
      <label for="owasys-site-id">[[ i18n: creation.site_id ]]</label>
      <input
        id="owasys-site-id"
        name="owasys_site_id"
        type="text"
        value="{{ creation.site_id }}"
        required
        minlength="1"
        maxlength="64"
        pattern="[a-z][a-z0-9-]*"
        autocomplete="off"
        spellcheck="false">
      <small class="ow-muted">[[ i18n: creation.site_id_help ]]</small>
    </div>

    <fieldset class="ow-profile-selector">
      <legend>[[ i18n: creation.profile ]]</legend>
      <label class="ow-card ow-profile-option">
        <input type="radio" name="owasys_profile" value="frontend" required [[ if: creation.profile_frontend ]]checked[[ endif ]]>
        <strong>[[ i18n: creation.profile.frontend ]]</strong>
        <span>[[ i18n: creation.profile.frontend_description ]]</span>
      </label>
      <label class="ow-card ow-profile-option">
        <input type="radio" name="owasys_profile" value="backend" required [[ if: creation.profile_backend ]]checked[[ endif ]]>
        <strong>[[ i18n: creation.profile.backend ]]</strong>
        <span>[[ i18n: creation.profile.backend_description ]]</span>
      </label>
      <label class="ow-card ow-profile-option">
        <input type="radio" name="owasys_profile" value="fullstack" required [[ if: creation.profile_fullstack ]]checked[[ endif ]]>
        <strong>[[ i18n: creation.profile.fullstack ]]</strong>
        <span>[[ i18n: creation.profile.fullstack_description ]]</span>
      </label>
    </fieldset>

    <div class="ow-inline-form">
      <button class="ow-button" type="submit" name="owasys_action" value="create-application">[[ i18n: creation.submit ]]</button>
      <button class="ow-button ow-button-secondary" type="submit" name="owasys_action" value="cancel-creation">[[ i18n: creation.cancel ]]</button>
    </div>
  </form>
</section>
