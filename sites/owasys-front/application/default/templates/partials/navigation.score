<nav
  class="ow-global-nav ow-fsm-menu"
  aria-label="[[ i18n: navigation.main ]]"
  data-fsm-menu-contract="OWASYS_FSM_MENU_V5"
  data-fsm-menu-behavior="canonical-state-signals-global-host-get-navigation-post-command-autocollapse"
>
  [[ foreach: navigation as item ]]
    [[ if: item.visible ]]
      [[ if: item.allowed ]]
        <details
          name="owasys-fsm-navigation"
          class="ow-fsm-menu-state[[ if: item.active ]] is-active[[ endif ]][[ if: item.available ]][[ else ]] is-disabled[[ endif ]]"
          data-state="{{ item.id }}"
          data-state-type="{{ item.state_type }}"
        >
          <summary
            class="ow-fsm-menu-state-label"
            [[ if: item.active ]]aria-current="page"[[ endif ]]
          >{{ item.label }}</summary>
          <div class="ow-fsm-menu-signals" aria-label="{{ item.label }}">
            [[ if: item.global_host ]]
              [[ if: item.has_global_signals ]]
                [[ foreach: item.global_signals as signal ]]
                  [[ if: signal.actionable ]]
                    <a
                      class="ow-fsm-menu-signal is-actionable signal-type-navigation"
                      href="{{ signal.url }}"
                      data-transition-id="{{ signal.transition_id }}"
                      data-signal="{{ signal.signal }}"
                      data-signal-type="navigation"
                      data-target-state="{{ signal.target }}"
                      data-global-transition="true"
                    >
                      <code>{{ signal.signal }}</code>
                      <span>→ {{ signal.target_label }}</span>
                    </a>
                  [[ else ]]
                    <span
                      class="ow-fsm-menu-signal is-passive signal-type-navigation"
                      aria-disabled="true"
                      data-transition-id="{{ signal.transition_id }}"
                      data-signal="{{ signal.signal }}"
                      data-signal-type="navigation"
                      data-target-state="{{ signal.target }}"
                      data-global-transition="true"
                    >
                      <code>{{ signal.signal }}</code>
                      <span>→ {{ signal.target_label }}</span>
                    </span>
                  [[ endif ]]
                [[ endforeach ]]
              [[ endif ]]
            [[ endif ]]

            [[ if: item.has_signals ]]
              [[ foreach: item.signals as signal ]]
                [[ if: signal.menu_actionable ]]
                  [[ if: signal.is_post ]]
                    <form
                      method="post"
                      action="{{ signal.url }}"
                      class="ow-fsm-menu-command-form"
                    >
                      <button
                        type="submit"
                        class="ow-fsm-menu-signal is-actionable signal-type-{{ signal.signal_type }}"
                        name="{{ signal.request_field }}"
                        value="{{ signal.request_value }}"
                        data-transition-id="{{ signal.transition_id }}"
                        data-signal="{{ signal.signal }}"
                        data-signal-type="{{ signal.signal_type }}"
                        data-source-state="{{ item.id }}"
                        data-target-state="{{ signal.target }}"
                      >
                        <code>{{ signal.signal }}</code>
                        <span>→ {{ signal.target_label }}</span>
                      </button>
                    </form>
                  [[ else ]]
                    <a
                      class="ow-fsm-menu-signal is-actionable signal-type-{{ signal.signal_type }}"
                      href="{{ signal.url }}"
                      data-transition-id="{{ signal.transition_id }}"
                      data-signal="{{ signal.signal }}"
                      data-signal-type="{{ signal.signal_type }}"
                      data-source-state="{{ item.id }}"
                      data-target-state="{{ signal.target }}"
                    >
                      <code>{{ signal.signal }}</code>
                      <span>→ {{ signal.target_label }}</span>
                    </a>
                  [[ endif ]]
                [[ else ]]
                  <span
                    class="ow-fsm-menu-signal is-passive signal-type-{{ signal.signal_type }}"
                    aria-disabled="true"
                    data-transition-id="{{ signal.transition_id }}"
                    data-signal="{{ signal.signal }}"
                    data-signal-type="{{ signal.signal_type }}"
                    data-source-state="{{ item.id }}"
                    data-target-state="{{ signal.target }}"
                  >
                    <code>{{ signal.signal }}</code>
                    <span>→ {{ signal.target_label }}</span>
                  </span>
                [[ endif ]]
              [[ endforeach ]]
            [[ else ]]
              [[ if: item.has_global_signals ]]
              [[ else ]]
                <span class="ow-fsm-menu-empty">∅</span>
              [[ endif ]]
            [[ endif ]]
          </div>
        </details>
      [[ endif ]]
    [[ endif ]]
  [[ endforeach ]]
</nav>
