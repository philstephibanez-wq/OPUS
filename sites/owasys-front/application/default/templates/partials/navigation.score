<nav
  class="ow-global-nav"
  aria-label="[[ i18n: navigation.main ]]"
  data-fsm-menu-contract="OWASYS_FSM_MENU_V2"
  data-fsm-menu-behavior="direct-state-transition"
>
  [[ foreach: navigation as item ]]
    [[ if: item.visible ]]
      [[ if: item.allowed ]]
        [[ if: item.available ]]
          [[ if: item.entry_actionable ]]
            <a
              class="ow-global-nav-link[[ if: item.active ]] is-active[[ endif ]]"
              href="{{ item.url }}"
              data-owasys-navigation-state="{{ item.id }}"
              data-transition-id="{{ item.entry_transition_id }}"
              data-signal="{{ item.entry_signal }}"
              [[ if: item.active ]]aria-current="page"[[ endif ]]
            >{{ item.label }}</a>
          [[ else ]]
            <span
              class="ow-global-nav-link is-disabled"
              aria-disabled="true"
              data-owasys-navigation-state="{{ item.id }}"
            >{{ item.label }}</span>
          [[ endif ]]
        [[ else ]]
          <span
            class="ow-global-nav-link is-disabled"
            aria-disabled="true"
            data-owasys-navigation-state="{{ item.id }}"
            data-owasys-current-app-required="true"
          >{{ item.label }}</span>
        [[ endif ]]
      [[ endif ]]
    [[ endif ]]
  [[ endforeach ]]
</nav>
