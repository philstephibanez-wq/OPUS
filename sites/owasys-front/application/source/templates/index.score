[[ if: source.has_error ]]
<p class="ow-error"><code>{{ source.error_code }}</code></p>
[[ endif ]]
<section class="ow-card">
  <div class="ow-section-heading">
    <div>
      <h2>{{ page.title }}</h2>
      <p class="ow-muted">{{ page.summary }}</p>
    </div>
    <div class="ow-tags">
      <span>[[ i18n: common.id ]]: {{ current_app.id }}</span>
      <span>[[ i18n: common.root ]]: {{ current_app.root }}</span>
    </div>
  </div>
  <div class="ow-grid">
    <article class="ow-card">
      <h3>{{ page.title }}</h3>
      [[ if: source.empty ]]
        <p class="ow-muted">{{ page.summary }}</p>
      [[ else ]]
        <div class="ow-source-file-tree" data-context="OWASYS_SOURCE_FILE_TREE">
          [[ foreach: source.files as file ]]
            <a class="ow-source-file" href="{{ file.url }}" data-source-path="{{ file.path }}" [[ if: file.selected ]]aria-current="page"[[ endif ]]>
                <span class="ow-source-file-marker" aria-hidden="true">✓</span>
                <span class="ow-source-file-name">{{ file.name }}</span>
                <small>{{ file.bytes }}</small>
            </a>
          [[ endforeach ]]
        </div>
      [[ endif ]]
    </article>
    <article class="ow-card" data-context="OWASYS_SOURCE_SELECTION">
      <h3 data-source-selection-path>{{ source.path }}</h3>
      <div class="ow-tags" data-source-selection-metadata [[ if: source.unselected ]]hidden[[ endif ]]>
        <span data-source-selection-bytes>{{ source.bytes }}</span>
        <span data-source-selection-sha256>{{ source.sha256 }}</span>
      </div>
      <p class="ow-muted" data-source-selection-empty [[ if: source.selected ]]hidden[[ endif ]]>{{ page.summary }}</p>
      <div class="ow-source-editor-host" data-context="OWASYS_SOURCE_CONTENT_EDITOR" [[ if: source.unselected ]]hidden[[ endif ]]>
        <textarea class="ow-source-content" data-source-path="{{ source.path }}" readonly>{{ source.content }}</textarea>
      </div>
    </article>
  </div>
</section>
