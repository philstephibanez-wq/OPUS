[[ if: source.saved ]]
<p class="ow-source-notice ow-source-notice-success" data-context="OWASYS_SOURCE_SAVED">[[ i18n: source.saved ]]</p>
[[ endif ]]
[[ if: source.conflict ]]
<p class="ow-source-notice ow-source-notice-conflict" data-context="OWASYS_SOURCE_CONFLICT">[[ i18n: source.conflict ]] <a href="{{ source.reload_url }}">[[ i18n: source.reload ]]</a></p>
[[ endif ]]
[[ if: source.failed ]]
<p class="ow-error" data-context="OWASYS_SOURCE_FAILURE">[[ i18n: source.failed ]] <code>{{ source.error_code }}</code></p>
[[ endif ]]
[[ if: git.staged_success ]]
<p class="ow-source-notice ow-source-notice-success" data-context="OWASYS_GIT_STAGED">[[ i18n: git.stage_success ]]</p>
[[ endif ]]
[[ if: git.staged_all_success ]]
<p class="ow-source-notice ow-source-notice-success" data-context="OWASYS_GIT_STAGED_ALL">[[ i18n: git.stage_all_success ]]</p>
[[ endif ]]
[[ if: git.unstaged_success ]]
<p class="ow-source-notice ow-source-notice-success" data-context="OWASYS_GIT_UNSTAGED">[[ i18n: git.unstage_success ]]</p>
[[ endif ]]
[[ if: git.committed_success ]]
<p class="ow-source-notice ow-source-notice-success" data-context="OWASYS_GIT_COMMITTED">[[ i18n: git.commit_success ]]</p>
[[ endif ]]
[[ if: git.restored_success ]]
<p class="ow-source-notice ow-source-notice-success" data-context="OWASYS_GIT_RESTORED">[[ i18n: git.restore_success ]]</p>
[[ endif ]]
<section class="ow-card ow-source-module">
  <div class="ow-section-heading">
    <div>
      <h2>{{ page.title }}</h2>
      <p class="ow-muted">{{ page.summary }}</p>
    </div>
    <div class="ow-tags">
      <span>[[ i18n: common.id ]]: {{ current_app.id }}</span>
      <span>[[ i18n: common.root ]]: {{ current_app.root }}</span>
    </div>
  </div>
  [[ if: source.truncated ]]
    <p class="ow-source-notice ow-source-notice-warning">[[ i18n: source.truncated ]]</p>
  [[ endif ]]
  <div class="ow-source-workspace">
    <aside class="ow-card ow-source-browser-panel">
      <h3>[[ i18n: source.files ]]</h3>
      [[ if: source.empty ]]
        <p class="ow-muted">[[ i18n: source.no_files ]]</p>
      [[ else ]]
        <div class="ow-source-file-tree" data-context="OWASYS_SOURCE_FILE_TREE">
          [[ foreach: source.files as file ]]
            <a class="ow-source-file" href="{{ file.url }}" data-source-path="{{ file.path }}" [[ if: file.selected ]]aria-current="page"[[ endif ]]>
              <span class="ow-source-file-marker" aria-hidden="true">✓</span>
              <span class="ow-source-file-name">{{ file.name }}</span>
              <small>{{ file.bytes }}</small>
            </a>
          [[ endforeach ]]
        </div>
      [[ endif ]]
    </aside>
    <section class="ow-source-editor-panel">
      <nav class="ow-source-tabs {{ source.selection_class }}" data-context="OWASYS_SOURCE_TABS" aria-label="[[ i18n: source.tabs ]]">
        <ul data-source-tabs-list>
          [[ if: source.selected ]]
            <li><a href="{{ source.url }}" data-source-path="{{ source.path }}" data-source-tab-path="{{ source.path }}" aria-current="page">{{ source.name }}</a></li>
          [[ endif ]]
        </ul>
      </nav>
      <p class="ow-source-empty-selection {{ source.unselected_class }}" data-source-selection-empty>[[ i18n: source.choose_file ]]</p>
      <article class="ow-card ow-source-selection {{ source.selection_class }}" data-context="OWASYS_SOURCE_SELECTION">
        <div class="ow-source-selection-heading">
          <div>
            <h3 data-source-selection-path>{{ source.path }}</h3>
            <div class="ow-tags" data-source-selection-metadata>
              <span>[[ i18n: source.bytes ]]: <strong data-source-selection-bytes>{{ source.bytes }}</strong></span>
              <span>SHA-256: <strong data-source-selection-sha256>{{ source.sha256 }}</strong></span>
            </div>
          </div>
          <div class="ow-source-dirty-state" aria-live="polite">
            <span data-source-clean [[ if: source.dirty ]]hidden[[ endif ]]>[[ i18n: source.clean ]]</span>
            <span data-source-dirty [[ if: source.clean ]]hidden[[ endif ]]>[[ i18n: source.dirty ]]</span>
          </div>
        </div>
        [[ if: source.read_only ]]
          <p class="ow-source-notice ow-source-notice-warning">[[ i18n: source.read_only ]]</p>
        [[ endif ]]
        <form method="post" action="{{ source.form_action }}" class="ow-source-editor-form" data-context="OWASYS_SOURCE_EDITOR_FORM" data-source-editable="{{ source.editable_value }}" data-unsaved-message="[[ i18n: source.unsaved_confirm ]]">
          <input type="hidden" name="csrf_token" value="{{ source.csrf_token }}">
          <input type="hidden" name="expected_content_hash" value="{{ source.expected_sha256 }}" data-source-expected-hash>
          <textarea data-source-server-content hidden readonly>{{ source.server_content }}</textarea>
          <div class="ow-source-editor-host" data-context="OWASYS_SOURCE_CONTENT_EDITOR">
            [[ if: source.editable ]]
              <textarea class="ow-source-content" name="new_content" data-source-path="{{ source.path }}" spellcheck="false">{{ source.content }}</textarea>
            [[ else ]]
              <textarea class="ow-source-content" name="new_content" data-source-path="{{ source.path }}" spellcheck="false" readonly>{{ source.content }}</textarea>
            [[ endif ]]
          </div>
          <div class="ow-source-actions">
            [[ if: source.can_preview ]]
              <button type="submit" name="source_action" value="preview" class="ow-button ow-button-secondary">[[ i18n: source.preview ]]</button>
            [[ else ]]
              <button type="submit" name="source_action" value="preview" class="ow-button ow-button-secondary" disabled>[[ i18n: source.preview ]]</button>
            [[ endif ]]
            [[ if: source.can_write ]]
              <button type="submit" name="source_action" value="write" class="ow-button">[[ i18n: source.save ]]</button>
            [[ else ]]
              <button type="submit" name="source_action" value="write" class="ow-button" disabled>[[ i18n: source.save ]]</button>
            [[ endif ]]
            <a class="ow-button ow-button-secondary" href="{{ source.reload_url }}">[[ i18n: source.reload ]]</a>
          </div>
        </form>
      </article>
      <section class="ow-card ow-source-preview" data-context="OWASYS_SOURCE_PREVIEW" [[ if: source_preview.absent ]]hidden[[ endif ]]>
        <div class="ow-section-heading">
          <div>
            <h3>[[ i18n: source.preview_title ]]</h3>
            <p class="ow-muted">
              [[ i18n: source.bytes ]]: {{ source_preview.current_bytes }} → {{ source_preview.proposed_bytes }}
            </p>
          </div>
          [[ if: source_preview.changed ]]
            <span class="ow-badge">[[ i18n: source.changed ]]</span>
          [[ endif ]]
        </div>
        [[ if: source_preview.unchanged ]]
          <p class="ow-muted">[[ i18n: source.no_changes ]]</p>
        [[ endif ]]
        [[ if: source_preview.changed ]]
          <pre class="ow-source-diff">{{ source_preview.diff }}</pre>
        [[ endif ]]
        [[ if: source_preview.diff_truncated ]]
          <p class="ow-source-notice ow-source-notice-warning">[[ i18n: source.diff_truncated ]]</p>
        [[ endif ]]
      </section>
    </section>
  </div>
</section>

<section class="ow-card ow-git-module" data-context="OWASYS_GIT_WORKSPACE">
  <div class="ow-section-heading">
    <div>
      <h2>[[ i18n: git.title ]]</h2>
      <p class="ow-muted">[[ i18n: source.saved ]]</p>
    </div>
    [[ if: git.available ]]
      <div class="ow-tags">
        <span>[[ i18n: git.branch ]]: {{ git.branch }}</span>
        <span>HEAD: {{ git.short_head }}</span>
      </div>
    [[ endif ]]
  </div>
  [[ if: git.failed ]]
    <p class="ow-error" data-context="OWASYS_GIT_FAILURE">[[ i18n: source.failed ]] <code>{{ git.error_code }}</code></p>
  [[ endif ]]
  [[ if: git.loadable ]]
    <div class="ow-git-summary" data-context="OWASYS_GIT_LAZY_LOAD">
      <p class="ow-muted">[[ i18n: git.status ]] · [[ i18n: git.history ]]</p>
      <a class="ow-button ow-button-secondary" href="{{ git.load_url }}">[[ i18n: git.title ]]</a>
    </div>
  [[ endif ]]
  [[ if: git.read_only ]]
    <p class="ow-source-notice ow-source-notice-warning">[[ i18n: git.read_only ]]</p>
  [[ endif ]]
  [[ if: git.available ]]
    <div class="ow-git-summary">
      <h3>[[ i18n: git.status ]]</h3>
      <div class="ow-tags">
        <span>{{ git.counts.staged }} [[ i18n: git.staged ]]</span>
        <span>{{ git.counts.unstaged }} [[ i18n: git.unstaged ]]</span>
        <span>{{ git.counts.untracked }} [[ i18n: git.untracked ]]</span>
      </div>
      [[ if: git.can_stage_all ]]
        <form method="post" action="{{ git.form_action }}" class="ow-git-stage-all-form">
          <input type="hidden" name="csrf_token" value="{{ git.csrf_token }}">
          <button type="submit" name="git_action" value="stage_all" class="ow-button">[[ i18n: git.stage_all ]]</button>
        </form>
      [[ endif ]]
    </div>
    [[ if: git.changes_empty ]]
      <p class="ow-muted">[[ i18n: source.no_changes ]]</p>
    [[ else ]]
      <div class="ow-git-change-list">
        [[ foreach: git.changes as change ]]
          <article class="ow-git-change [[ if: change.selected ]]is-selected[[ endif ]]">
            <div class="ow-git-change-heading">
              [[ if: change.source_readable ]]
                <a href="{{ change.url }}" data-source-path="{{ change.path }}"><strong>{{ change.path }}</strong></a>
              [[ else ]]
                <strong>{{ change.path }}</strong>
              [[ endif ]]
              <div class="ow-tags">
                [[ if: change.staged ]]
                  <span>[[ i18n: git.staged ]]</span>
                [[ endif ]]
                [[ if: change.unstaged ]]
                  <span>[[ i18n: git.unstaged ]]</span>
                [[ endif ]]
                [[ if: change.untracked ]]
                  <span>[[ i18n: git.untracked ]]</span>
                [[ endif ]]
                [[ if: change.conflicted ]]
                  <span>[[ i18n: git.conflicted ]]</span>
                [[ endif ]]
                <span>{{ change.index_status }}{{ change.worktree_status }}</span>
              </div>
            </div>
            <div class="ow-git-actions">
              [[ if: change.can_stage ]]
                <form method="post" action="{{ git.form_action }}">
                  <input type="hidden" name="csrf_token" value="{{ git.csrf_token }}">
                  <input type="hidden" name="git_path" value="{{ change.path }}">
                  <button type="submit" name="git_action" value="stage" class="ow-button">[[ i18n: git.stage ]]</button>
                </form>
              [[ endif ]]
              [[ if: change.can_unstage ]]
                <form method="post" action="{{ git.form_action }}">
                  <input type="hidden" name="csrf_token" value="{{ git.csrf_token }}">
                  <input type="hidden" name="git_path" value="{{ change.path }}">
                  <button type="submit" name="git_action" value="unstage" class="ow-button ow-button-secondary">[[ i18n: git.unstage ]]</button>
                </form>
              [[ endif ]]
            </div>
            [[ if: change.can_restore ]]
              <details class="ow-git-restore">
                <summary>[[ i18n: git.restore ]]</summary>
                <p class="ow-muted">[[ i18n: git.restore_instruction ]]</p>
                <code>{{ change.restore_confirmation }}</code>
                <form method="post" action="{{ git.form_action }}">
                  <input type="hidden" name="csrf_token" value="{{ git.csrf_token }}">
                  <input type="hidden" name="git_path" value="{{ change.path }}">
                  <input type="hidden" name="git_expected_content_hash" value="{{ change.sha256 }}">
                  <label>[[ i18n: git.confirmation ]]
                    <input type="text" name="restore_confirmation" required maxlength="700" autocomplete="off">
                  </label>
                  <button type="submit" name="git_action" value="restore" class="ow-button ow-button-secondary">[[ i18n: git.restore ]]</button>
                </form>
              </details>
            [[ endif ]]
          </article>
        [[ endforeach ]]
      </div>
    [[ endif ]]

    <section class="ow-card ow-git-diff" data-context="OWASYS_GIT_DIFF" [[ if: git_diff.absent ]]hidden[[ endif ]]>
      <h3>[[ i18n: git.diff ]] — {{ git_diff.path }}</h3>
      [[ if: git_diff.empty ]]
        <p class="ow-muted">[[ i18n: source.no_changes ]]</p>
      [[ endif ]]
      [[ if: git_diff.has_unstaged ]]
        <h4>[[ i18n: git.unstaged ]]</h4>
        <pre class="ow-source-diff">{{ git_diff.unstaged }}</pre>
      [[ endif ]]
      [[ if: git_diff.unstaged_truncated ]]
        <p class="ow-source-notice ow-source-notice-warning">[[ i18n: source.diff_truncated ]]</p>
      [[ endif ]]
      [[ if: git_diff.has_staged ]]
        <h4>[[ i18n: git.staged ]]</h4>
        <pre class="ow-source-diff">{{ git_diff.staged }}</pre>
      [[ endif ]]
      [[ if: git_diff.staged_truncated ]]
        <p class="ow-source-notice ow-source-notice-warning">[[ i18n: source.diff_truncated ]]</p>
      [[ endif ]]
    </section>

    <section class="ow-card ow-git-commit">
      <h3>[[ i18n: git.commit ]]</h3>
      <form method="post" action="{{ git.form_action }}" class="ow-git-commit-form">
        <input type="hidden" name="csrf_token" value="{{ git.csrf_token }}">
        <label>[[ i18n: git.message ]]
          <input type="text" name="commit_message" value="{{ git.commit_message }}" required maxlength="200" autocomplete="off">
        </label>
        [[ if: git.can_commit ]]
          <button type="submit" name="git_action" value="commit" class="ow-button">[[ i18n: git.commit ]]</button>
        [[ else ]]
          <button type="submit" name="git_action" value="commit" class="ow-button" disabled>[[ i18n: git.commit ]]</button>
        [[ endif ]]
      </form>
    </section>

    <section class="ow-card ow-git-history">
      <h3>[[ i18n: git.history ]]</h3>
      [[ if: git.history_empty ]]
        <p class="ow-muted">[[ i18n: git.no_history ]]</p>
      [[ else ]]
        <ol>
          [[ foreach: git.commits as commit ]]
            <li>
              <code>{{ commit.short_hash }}</code>
              <strong>{{ commit.subject }}</strong>
              <span>{{ commit.author }} · {{ commit.date }}</span>
            </li>
          [[ endforeach ]]
        </ol>
      [[ endif ]]
    </section>
  [[ endif ]]
</section>
