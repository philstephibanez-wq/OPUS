<section class="ow-card">
  <div class="ow-section-heading">
    <div>
      <h2>[[ i18n: security.workspace ]]</h2>
      <p class="ow-muted">[[ i18n: security.description ]]</p>
    </div>
    [[ if: security.can_mutate ]]
      <span class="ow-badge">[[ i18n: security.controlled_mutations ]]</span>
    [[ endif ]]
    [[ if: security.cannot_mutate ]]
      <span class="ow-badge">[[ i18n: security.read_only ]]</span>
    [[ endif ]]
  </div>
  <div class="ow-tags">
    <span>[[ i18n: common.id ]]: {{ security.application_id }}</span>
    <span>[[ i18n: common.kind ]]: {{ security.application_kind }}</span>
    <span>ACL: {{ security.acl_contract }}</span>
    <span>SSO: {{ security.sso_contract }}</span>
    <span>[[ i18n: security.default_policy ]]: {{ security.default_policy }}</span>
    <span>[[ i18n: security.default_provider ]]: {{ security.default_provider }}</span>
  </div>
  [[ if: security.authentication_known ]]
    [[ if: security.authentication_required ]]
      <p>[[ i18n: security.authentication_required ]]</p>
    [[ else ]]
      <p>[[ i18n: security.authentication_public ]]</p>
    [[ endif ]]
  [[ endif ]]
  [[ if: security.onboarding_present ]]
    <p>[[ i18n: security.onboarding_present ]]</p>
  [[ endif ]]
  [[ if: security.onboarding_absent ]]
    <p class="ow-muted">[[ i18n: security.onboarding_absent ]]</p>
  [[ endif ]]
  [[ if: security.target_protected ]]
    <p class="ow-muted">[[ i18n: security.target_protected ]]</p>
  [[ endif ]]
  [[ if: security.reauth_unsupported ]]
    <p class="ow-muted">[[ i18n: security.reauth_provider_unsupported ]]</p>
  [[ endif ]]
</section>

<section class="ow-card ow-security-map-card" aria-label="[[ i18n: security.access_model ]]">
  <h2>[[ i18n: security.access_model ]]</h2>
  <div class="ow-security-flow">
    <a class="ow-security-flow-node" href="{{ security_urls.identities }}"><strong>[[ i18n: security.identities ]]</strong><code>provider + subject</code></a>
    <span class="ow-security-flow-arrow" aria-hidden="true">→</span>
    <a class="ow-security-flow-node" href="{{ security_urls.assignments }}"><strong>[[ i18n: security.assignments ]]</strong><code>scope</code></a>
    <span class="ow-security-flow-arrow" aria-hidden="true">→</span>
    <a class="ow-security-flow-node" href="{{ security_urls.roles }}"><strong>[[ i18n: security.roles ]]</strong><code>role_id</code></a>
    <span class="ow-security-flow-arrow" aria-hidden="true">→</span>
    <a class="ow-security-flow-node" href="{{ security_urls.permissions }}"><strong>[[ i18n: security.permissions ]]</strong><code>resource:action</code></a>
    <span class="ow-security-flow-arrow" aria-hidden="true">→</span>
    <a class="ow-security-flow-node" href="{{ security_urls.resources }}"><strong>[[ i18n: security.resources_acl ]]</strong><code>ACL</code></a>
  </div>
</section>

[[ if: security.mutation_error ]]
<section class="ow-card">
  <h2>[[ i18n: security.mutation_error ]]</h2>
  <code>{{ security.mutation_error_code }}</code>
</section>
[[ endif ]]

[[ if: security.mutation_preview ]]
<section class="ow-card">
  <h2>[[ i18n: security.preview_title ]]</h2>
  <p class="ow-muted">[[ i18n: security.preview_description ]]</p>
  <div class="ow-tags">
    <span>[[ i18n: security.mutation_type ]]: {{ mutation.type }}</span>
    <span>[[ i18n: security.files ]]: {{ mutation.files }}</span>
    <span>[[ i18n: security.reason ]]: {{ mutation.reason }}</span>
  </div>
  <ol class="ow-event-list">
    [[ foreach: mutation_diff as row ]]
      <li><strong>{{ row.path }}</strong><span>{{ row.summary }}</span></li>
    [[ endforeach ]]
  </ol>
  <h3>[[ i18n: security.access_gained ]]</h3>
  <div class="ow-tags">
    [[ foreach: mutation_gained as row ]]
      <span>{{ row.value }}</span>
    [[ endforeach ]]
  </div>
  <form method="post" action="{{ urls.current }}">
    <input type="hidden" name="owasys_csrf_token" value="{{ csrf.token }}">
    <input type="hidden" name="owasys_security_phase" value="commit">
    <input type="hidden" name="owasys_security_mutation" value="{{ mutation.type }}">
    <input type="hidden" name="owasys_security_provider" value="{{ mutation.provider }}">
    <input type="hidden" name="owasys_security_subject" value="{{ mutation.subject }}">
    <input type="hidden" name="owasys_security_identity_type" value="{{ mutation.identity_type }}">
    <input type="hidden" name="owasys_security_role" value="{{ mutation.role }}">
    <input type="hidden" name="owasys_security_permission" value="{{ mutation.permission }}">
    <input type="hidden" name="owasys_security_resource" value="{{ mutation.resource }}">
    <input type="hidden" name="owasys_security_action" value="{{ mutation.action }}">
    <input type="hidden" name="owasys_security_reason" value="{{ mutation.reason }}">
    <input type="hidden" name="owasys_expected_state_hash" value="{{ mutation.expected_state_hash }}">
    <input type="hidden" name="owasys_confirmation_token" value="{{ mutation.confirmation_token }}">
    <label>[[ i18n: security.reauthenticate ]]
      <input type="password" name="owasys_reauth_password" autocomplete="current-password" required>
    </label>
    <button class="ow-button ow-button-danger" type="submit">[[ i18n: security.confirm_commit ]]</button>
    <a class="ow-button ow-button-secondary" href="{{ urls.current }}">[[ i18n: security.cancel ]]</a>
  </form>
</section>
[[ endif ]]

[[ if: security.mutation_committed ]]
<section class="ow-card">
  <h2>[[ i18n: security.commit_succeeded ]]</h2>
  <div class="ow-tags">
    <span>[[ i18n: security.mutation_type ]]: {{ mutation.type }}</span>
    <span>[[ i18n: security.files ]]: {{ mutation.files }}</span>
  </div>
  <ol class="ow-event-list">
    [[ foreach: mutation_diff as row ]]
      <li><strong>{{ row.path }}</strong><span>{{ row.summary }}</span></li>
    [[ endforeach ]]
  </ol>
</section>
[[ endif ]]

[[ if: security.view_identities ]]
<details class="ow-security-accordion" open>
  <summary><strong>[[ i18n: security.identities ]]</strong></summary>
  <div class="ow-security-accordion-body">
    <div class="ow-security-identity-grid">
      <details class="ow-security-subaccordion" open>
        <summary>[[ i18n: security.users ]]</summary>
        <div class="ow-tree-branches">
          [[ foreach: users as identity ]]
            <article class="ow-tree-app ow-security-identity-card">
              <strong>{{ identity.subject }}</strong>
              <div class="ow-tags">
                <span>[[ i18n: security.provider ]]: {{ identity.provider }}</span>
                <span>[[ i18n: security.status ]]: {{ identity.status }}</span>
                <span>[[ i18n: security.roles ]]: {{ identity.roles }}</span>
              </div>
            </article>
          [[ endforeach ]]
        </div>
      </details>

      <details class="ow-security-subaccordion">
        <summary>[[ i18n: security.agents ]]</summary>
        <div class="ow-tree-branches">
          [[ foreach: agents as identity ]]
            <article class="ow-tree-app ow-security-identity-card">
              <strong>{{ identity.subject }}</strong>
              <div class="ow-tags">
                <span>[[ i18n: security.provider ]]: {{ identity.provider }}</span>
                <span>[[ i18n: security.status ]]: {{ identity.status }}</span>
                <span>[[ i18n: security.roles ]]: {{ identity.roles }}</span>
              </div>
            </article>
          [[ endforeach ]]
        </div>
      </details>

      <details class="ow-security-subaccordion">
        <summary>[[ i18n: security.unclassified ]]</summary>
        <div class="ow-tree-branches">
          [[ foreach: unknown_identities as identity ]]
            <article class="ow-tree-app ow-security-identity-card">
              <strong>{{ identity.subject }}</strong>
              <div class="ow-tags">
                <span>[[ i18n: security.provider ]]: {{ identity.provider }}</span>
                <span>[[ i18n: security.status ]]: {{ identity.status }}</span>
                <span>[[ i18n: security.roles ]]: {{ identity.roles }}</span>
                <span>[[ i18n: security.source ]]: {{ identity.source }}</span>
              </div>
            </article>
          [[ endforeach ]]
        </div>
      </details>
    </div>

    [[ if: security.identity_reference_supported ]]
      <form class="ow-security-action-form" method="post" action="{{ security_urls.identities }}">
        <h3>[[ i18n: security.identity_reference ]]</h3>
        <input type="hidden" name="owasys_csrf_token" value="{{ csrf.token }}">
        <input type="hidden" name="owasys_security_phase" value="preview">
        <input type="hidden" name="owasys_security_mutation" value="identity.reference">
        <label>[[ i18n: security.identity_type ]]
          <select name="owasys_security_identity_type" required>
            <option value="user">[[ i18n: security.user ]]</option>
            <option value="agent">[[ i18n: security.agent ]]</option>
          </select>
        </label>
        <label>[[ i18n: security.provider ]]
          <input name="owasys_security_provider" required>
        </label>
        <label>[[ i18n: security.subject ]]
          <input name="owasys_security_subject" required>
        </label>
        <label>[[ i18n: security.reason ]]
          <input name="owasys_security_reason" minlength="3" maxlength="200" required>
        </label>
        <label>[[ i18n: security.reauthenticate ]]
          <input type="password" name="owasys_reauth_password" autocomplete="current-password" required>
        </label>
        <button class="ow-button" type="submit">[[ i18n: security.preview ]]</button>
      </form>
    [[ endif ]]
  </div>
</details>
[[ endif ]]
[[ if: security.view_roles ]]
<details class="ow-security-accordion">
  <summary><strong>[[ i18n: security.roles ]]</strong></summary>
  <div class="ow-security-accordion-body">
  [[ if: security.roles_empty ]]
    <p class="ow-muted">[[ i18n: security.empty ]]</p>
  [[ else ]]
    <div class="ow-tree-branches">
      [[ foreach: roles as role ]]
        <article class="ow-tree-app">
          <strong>{{ role.id }}</strong>
          <div class="ow-tags">
            <span>[[ i18n: security.permissions_count ]]: {{ role.permissions_count }}</span>
          </div>
          [[ if: role.assignment_known ]]
            <p>{{ role.permissions }}</p>
          [[ endif ]]
          [[ if: role.assignment_unknown ]]
            <p class="ow-muted">[[ i18n: security.role_permission_mapping_unavailable ]]</p>
          [[ endif ]]
        </article>
      [[ endforeach ]]
    </div>
  [[ endif ]]
  [[ if: security.role_create_supported ]]
    <form method="post" action="{{ security_urls.roles }}">
      <h3>[[ i18n: security.role_create ]]</h3>
      <input type="hidden" name="owasys_csrf_token" value="{{ csrf.token }}">
      <input type="hidden" name="owasys_security_phase" value="preview">
      <input type="hidden" name="owasys_security_mutation" value="role.create">
      <label>[[ i18n: security.role_id ]]
        <input name="owasys_security_role" required>
      </label>
      <label>[[ i18n: security.reason ]]
        <input name="owasys_security_reason" minlength="3" maxlength="200" required>
      </label>
      <label>[[ i18n: security.reauthenticate ]]
        <input type="password" name="owasys_reauth_password" autocomplete="current-password" required>
      </label>
      <button class="ow-button" type="submit">[[ i18n: security.preview ]]</button>
    </form>
  [[ endif ]]
  </div>
</details>
[[ endif ]]

[[ if: security.view_permissions ]]
<details class="ow-security-accordion">
  <summary><strong>[[ i18n: security.permissions ]]</strong></summary>
  <div class="ow-security-accordion-body">
  [[ if: security.permissions_empty ]]
    <p class="ow-muted">[[ i18n: security.empty ]]</p>
  [[ else ]]
    <ol class="ow-event-list">
      [[ foreach: permissions as permission ]]
        <li>
          <strong>{{ permission.id }}</strong>
          <span>{{ permission.resource }}</span>
          <span>{{ permission.action }}</span>
        </li>
      [[ endforeach ]]
    </ol>
  [[ endif ]]
  [[ if: security.permission_grant_supported ]]
    <form method="post" action="{{ security_urls.permissions }}">
      <h3>[[ i18n: security.permission_grant ]]</h3>
      <input type="hidden" name="owasys_csrf_token" value="{{ csrf.token }}">
      <input type="hidden" name="owasys_security_phase" value="preview">
      <input type="hidden" name="owasys_security_mutation" value="permission.grant">
      <label>[[ i18n: security.role_id ]]
        <input name="owasys_security_role" required>
      </label>
      <label>[[ i18n: security.permission_id ]]
        <input name="owasys_security_permission" placeholder="resource:action" required>
      </label>
      <label>[[ i18n: security.reason ]]
        <input name="owasys_security_reason" minlength="3" maxlength="200" required>
      </label>
      <label>[[ i18n: security.reauthenticate ]]
        <input type="password" name="owasys_reauth_password" autocomplete="current-password" required>
      </label>
      <button class="ow-button" type="submit">[[ i18n: security.preview ]]</button>
    </form>
  [[ endif ]]
  </div>
</details>
[[ endif ]]

[[ if: security.view_assignments ]]
<details class="ow-security-accordion">
  <summary><strong>[[ i18n: security.assignments ]]</strong></summary>
  <div class="ow-security-accordion-body">
  [[ if: security.assignments_empty ]]
    <p class="ow-muted">[[ i18n: security.empty ]]</p>
  [[ else ]]
    <ol class="ow-event-list">
      [[ foreach: assignments as assignment ]]
        <li>
          <strong>{{ assignment.subject }}</strong>
          <span>{{ assignment.role }}</span>
          <span>{{ assignment.scope_type }}:{{ assignment.scope_id }}</span>
          <span>{{ assignment.source }}</span>
        </li>
      [[ endforeach ]]
    </ol>
  [[ endif ]]
  [[ if: security.assignment_grant_supported ]]
    <form method="post" action="{{ security_urls.assignments }}">
      <h3>[[ i18n: security.assignment_grant ]]</h3>
      <input type="hidden" name="owasys_csrf_token" value="{{ csrf.token }}">
      <input type="hidden" name="owasys_security_phase" value="preview">
      <input type="hidden" name="owasys_security_mutation" value="assignment.grant">
      <label>[[ i18n: security.subject ]]
        <input name="owasys_security_subject" required>
      </label>
      <label>[[ i18n: security.role_id ]]
        <input name="owasys_security_role" required>
      </label>
      <label>[[ i18n: security.reason ]]
        <input name="owasys_security_reason" minlength="3" maxlength="200" required>
      </label>
      <label>[[ i18n: security.reauthenticate ]]
        <input type="password" name="owasys_reauth_password" autocomplete="current-password" required>
      </label>
      <button class="ow-button" type="submit">[[ i18n: security.preview ]]</button>
    </form>
  [[ endif ]]
  [[ if: security.assignment_grant_unsupported ]]
    <p class="ow-muted">[[ i18n: security.assignment_runtime_required ]]</p>
  [[ endif ]]
  </div>
</details>
[[ endif ]]

[[ if: security.view_resources ]]
<details class="ow-security-accordion">
  <summary><strong>[[ i18n: security.resources_acl ]]</strong></summary>
  <div class="ow-security-accordion-body">
  <p class="ow-muted">[[ i18n: security.resource_right_rule ]]</p>
  [[ if: security.resources_empty ]]
    <p class="ow-muted">[[ i18n: security.empty ]]</p>
  [[ else ]]
    <ol class="ow-event-list">
      [[ foreach: resources as resource ]]
        <li>
          <strong>{{ resource.resource }}:{{ resource.action }}</strong>
          <span>[[ i18n: security.allowed_roles ]]: {{ resource.allowed_roles }}</span>
          <span>{{ resource.source }}</span>
        </li>
      [[ endforeach ]]
    </ol>
  [[ endif ]]
  [[ if: security.resource_allow_supported ]]
    <form method="post" action="{{ security_urls.resources }}">
      <h3>[[ i18n: security.resource_allow ]]</h3>
      <input type="hidden" name="owasys_csrf_token" value="{{ csrf.token }}">
      <input type="hidden" name="owasys_security_phase" value="preview">
      <input type="hidden" name="owasys_security_mutation" value="resource.allow">
      <label>[[ i18n: security.resource_id ]]
        <input name="owasys_security_resource" required>
      </label>
      <label>[[ i18n: security.action_id ]]
        <input name="owasys_security_action" required>
      </label>
      <label>[[ i18n: security.role_id ]]
        <input name="owasys_security_role" required>
      </label>
      <label>[[ i18n: security.reason ]]
        <input name="owasys_security_reason" minlength="3" maxlength="200" required>
      </label>
      <label>[[ i18n: security.reauthenticate ]]
        <input type="password" name="owasys_reauth_password" autocomplete="current-password" required>
      </label>
      <button class="ow-button" type="submit">[[ i18n: security.preview ]]</button>
    </form>
  [[ endif ]]
</section>
[[ endif ]]

<section class="ow-card">
  <h2>[[ i18n: security.providers ]]</h2>
  <div class="ow-tags">
    [[ foreach: providers as provider ]]
      [[ if: provider.enabled ]]
        <span>{{ provider.id }} · [[ i18n: security.enabled ]]</span>
      [[ endif ]]
      [[ if: provider.disabled ]]
        <span>{{ provider.id }} · [[ i18n: security.disabled ]]</span>
      [[ endif ]]
    [[ endforeach ]]
  </div>
  </div>
</details>
