<!doctype html>
<html lang="{{ locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ error.code }}</title>
  <link rel="stylesheet" href="{{ assets.score_css }}">
  <link rel="stylesheet" href="{{ assets.theme_css }}">
</head>
<body data-opus-application="owasys" data-opus-runtime="front">
  <main class="ow-shell">
    <section class="ow-card ow-error" role="alert">
      <h1>{{ error.code }}</h1>
      <dl>
        <dt>trace_id</dt>
        <dd><code>{{ error.trace_id }}</code></dd>
      </dl>
    </section>
  </main>
</body>
</html>
