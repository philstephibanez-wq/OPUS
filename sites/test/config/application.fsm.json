{
    "contract": "OPUS_APPLICATION_FSM_V1",
    "name": "test.application",
    "site_id": "test",
    "initial_state": "home",
    "states": [
        {
            "id": "home",
            "module": "home",
            "route": "/",
            "title_key": "menu.home",
            "summary_key": "page.subtitle",
            "navigation": {
                "label": "menu.home"
            }
        },
        {
            "id": "profiler",
            "module": "profiler",
            "route": "/_opus/profiler/trace/{trace_id}",
            "title_key": "profiler.title",
            "summary_key": "profiler.summary",
            "navigation": {
                "label": "OPUS Profiler"
            }
        }
    ],
    "transitions": [
        {
            "id": "open.home",
            "from": "*",
            "signal": "open_home",
            "next_state": "home",
            "guards": [
                "route_exists"
            ],
            "actions": [
                "render_route"
            ]
        },
        {
            "id": "open.profiler",
            "from": "*",
            "signal": "open_profiler",
            "next_state": "profiler",
            "guards": [
                "route_exists"
            ],
            "actions": [
                "render_profiler_trace"
            ]
        }
    ]
}

